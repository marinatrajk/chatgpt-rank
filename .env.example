# Copy this file to .env.local and fill in the keys for the assistants you want to check.
# Restart `npm run dev` after changing it.

# ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Claude — https://platform.claude.com/settings/keys
# Required: Claude also reads every answer and extracts the products.
ANTHROPIC_API_KEY=

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
# OPENAI_MODEL=gpt-6.1-sol
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash

# Optional: the model and effort used to extract products from the answers
# ANALYZER_MODEL=claude-opus-5-5
# ANALYZER_EFFORT=medium
# QUERY_MODEL=claude-haiku-5-5   # writes the queries on the "Check a brand in ChatGPT" page
